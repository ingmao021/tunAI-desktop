<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tunai.desktop.ui.NewVehicleController">
    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT" spacing="14">
            <Button text="Garaje" styleClass="ghost" onAction="#onCancel">
                <graphic>
                    <FontIcon iconLiteral="mdal-arrow_back"/>
                </graphic>
            </Button>
            <Region styleClass="top-bar-divider"/>
            <Label text="Nuevo vehículo" styleClass="subtitle"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox styleClass="flow-steps">
                <Label text="Foto" styleClass="flow-step, active">
                    <graphic><Label text="1" styleClass="step-num"/></graphic>
                </Label>
                <Region styleClass="flow-sep"/>
                <Label text="Modelo 3D" styleClass="flow-step">
                    <graphic><Label text="2" styleClass="step-num"/></graphic>
                </Label>
                <Region styleClass="flow-sep"/>
                <Label text="Color" styleClass="flow-step">
                    <graphic><Label text="3" styleClass="step-num"/></graphic>
                </Label>
            </HBox>
        </HBox>
    </top>
    <center>
        <VBox spacing="18">
            <padding>
                <Insets top="26" right="44" bottom="24" left="44"/>
            </padding>
            <HBox spacing="32" VBox.vgrow="ALWAYS">
                <VBox spacing="10" HBox.hgrow="ALWAYS">
                    <StackPane fx:id="dropZone" styleClass="drop-zone" minHeight="300" prefHeight="380"
                               VBox.vgrow="ALWAYS" maxWidth="680">
                        <ImageView fx:id="previewImage" preserveRatio="true" smooth="true"/>
                        <VBox fx:id="dropHint" alignment="CENTER" spacing="12">
                            <StackPane styleClass="icon-badge">
                                <FontIcon iconLiteral="mdal-add_photo_alternate"/>
                            </StackPane>
                            <Label text="Arrastra tu foto aquí" styleClass="drop-title"/>
                            <HBox alignment="CENTER" spacing="10">
                                <Label text="o" styleClass="muted"/>
                                <Button text="Elegir archivo" onAction="#onChooseFile">
                                    <graphic>
                                        <FontIcon iconLiteral="mdal-file_upload"/>
                                    </graphic>
                                </Button>
                            </HBox>
                            <Label text="JPG o PNG · máx. 10 MB" styleClass="muted, small"/>
                        </VBox>
                    </StackPane>
                    <HBox fx:id="statusRow" spacing="8" alignment="CENTER_LEFT" maxWidth="680">
                        <ProgressIndicator fx:id="checkingIndicator" prefWidth="18" prefHeight="18"
                                           visible="false" managed="false"/>
                        <Label fx:id="statusLabel" wrapText="true"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="changePhotoButton" text="Cambiar foto" onAction="#onChooseFile"
                                visible="false" managed="false" minWidth="-Infinity">
                            <graphic>
                                <FontIcon iconLiteral="mdal-cached"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
                <VBox styleClass="tips-panel" spacing="12" minWidth="320" maxWidth="370" maxHeight="-Infinity">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <FontIcon iconLiteral="mdal-lightbulb" iconSize="20" styleClass="icon-warn"/>
                        <Label text="Tips para tomar la foto de tu vehículo" styleClass="how-step-title" wrapText="true"/>
                    </HBox>
                    <VBox styleClass="tip">
                        <Label text="Muestra el vehículo completo" styleClass="ok-text">
                            <graphic><FontIcon iconLiteral="mdal-check_circle" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Incluye todas las partes del vehículo dentro de la foto." styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="tip">
                        <Label text="Toma la foto en diagonal" styleClass="ok-text">
                            <graphic><FontIcon iconLiteral="mdal-check_circle" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Haz que se vean el frente y uno de los laterales." styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="tip">
                        <Label text="Busca buena iluminación" styleClass="ok-text">
                            <graphic><FontIcon iconLiteral="mdal-check_circle" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Evita sombras fuertes y reflejos que oculten detalles." styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="tip">
                        <Label text="Elige un fondo despejado" styleClass="ok-text">
                            <graphic><FontIcon iconLiteral="mdal-check_circle" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Evita objetos que puedan confundirse con el vehículo." styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="tip">
                        <Label text="Mantén una buena distancia" styleClass="ok-text">
                            <graphic><FontIcon iconLiteral="mdal-check_circle" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Toma la foto desde lejos para capturar la forma y las proporciones del vehículo."
                               styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                    <VBox styleClass="tip">
                        <Label text="Evita fotos borrosas o parciales" styleClass="error-text">
                            <graphic><FontIcon iconLiteral="mdal-cancel" iconSize="18"/></graphic>
                        </Label>
                        <Label text="Indispensable una imagen clara para modelar el vehículo correctamente."
                               styleClass="muted, small, tip-detail" wrapText="true"/>
                    </VBox>
                </VBox>
            </HBox>

            <HBox styleClass="form-row" spacing="14" alignment="CENTER_LEFT">
                <Label text="Nombre:" styleClass="text-bold"/>
                <TextField fx:id="nameField" promptText="Ej: Mazda 3 2024" prefColumnCount="24"/>
                <Label fx:id="quotaWarning" styleClass="warn-text, small" wrapText="true"
                       HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Button text="Cancelar" styleClass="ghost" onAction="#onCancel"/>
                <Button fx:id="generateButton" text="Generar modelo" styleClass="primary, large" onAction="#onGenerate"
                        contentDisplay="LEFT" minWidth="-Infinity">
                    <graphic>
                        <FontIcon iconLiteral="mdmz-memory"/>
                    </graphic>
                </Button>
            </HBox>
        </VBox>
    </center>
</BorderPane>
