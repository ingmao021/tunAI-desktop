<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.tunai.desktop.ui.ConsentController">
    <VBox styleClass="surface" maxWidth="620" maxHeight="-Infinity" spacing="18" alignment="TOP_CENTER">
        <padding>
            <Insets top="36" right="44" bottom="36" left="44"/>
        </padding>
        <Label text="TunAI" styleClass="title, app-name" style="-fx-font-size: 32px;"/>
        <Label text="Mira tu carro en 3D y pruébale colores nuevos." styleClass="muted" style="-fx-font-size: 16px;"/>

        <VBox spacing="8" maxWidth="Infinity">
            <Label text="¿Cómo funciona?" styleClass="section-title"/>
            <Label text="①  Sube una foto de tu carro"/>
            <Label text="②  La IA crea un modelo 3D (≈ 1 minuto)"/>
            <Label text="③  Cámbiale el color y guárdalo en tu garaje"/>
        </VBox>

        <VBox styleClass="notice" spacing="6" maxWidth="Infinity">
            <Label fx:id="summaryLabel" wrapText="true"/>
            <Button text="Ver detalles" styleClass="link" onAction="#onShowDetails"/>
        </VBox>

        <CheckBox fx:id="acceptCheck" text="Acepto el envío de mis fotos para generar modelos" maxWidth="Infinity"/>

        <Button fx:id="startButton" text="Empezar" styleClass="primary" defaultButton="true"
                onAction="#onStart" prefWidth="160"/>
    </VBox>
</StackPane>
